---
import Layout from '../layouts/Layout.astro';
import { ArrowRight } from '@lucide/astro';
import { profile, publications, researchInterests } from '../data/profile';
const selectedPublications = publications.filter((item) => item.selected).slice(0, 2);
---

<Layout title={`${profile.name} — Academic Profile`} description={`Academic profile, research, and selected publications of ${profile.name}.`}>
  <section class="intro page-first">
    <p class="section-kicker">About</p><h2>{profile.headline}</h2>
    <p class="intro-lead">{profile.bio[0]}</p><p>{profile.bio[1]}</p>
    <div class="status-note"><span class="status-dot"></span>{profile.availability}</div>
  </section>
  <section class="home-preview">
    <div class="section-heading"><div><p class="section-kicker">Research</p><h2>Current interests</h2></div><a class="text-link" href="/research/">Explore research <ArrowRight size={16} /></a></div>
    <div class="interest-grid compact">{researchInterests.map((item, index) => <article class="interest-item"><span>0{index + 1}</span><h3>{item.title}</h3></article>)}</div>
  </section>
  <section class="home-preview">
    <div class="section-heading"><div><p class="section-kicker">Selected work</p><h2>Recent publications</h2></div><a class="text-link" href="/publications/">All publications <ArrowRight size={16} /></a></div>
    <div class="publication-list">{selectedPublications.map((item) => <article class="publication"><div class="publication-year">{item.year}</div><div><h3>{item.title}</h3><p class="authors">{item.authors}</p><p class="venue">{item.venue}</p></div></article>)}</div>
  </section>
  <footer><span>© {new Date().getFullYear()} {profile.name}</span><span>Built with Astro</span></footer>
</Layout>
