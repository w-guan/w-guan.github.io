---
import Layout from '../layouts/Layout.astro';
import { ArrowRight } from '@lucide/astro';
import { profile, publications, researchApproach, researchInterests } from '../data/profile';
import { updates } from '../data/updates';
const selectedPublications = publications.filter((item) => item.selected).slice(0, 2);
const recentUpdates = [...updates].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);
const formatDate = (date: string) => new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric' }).format(new Date(`${date}T12:00:00`));
---

<Layout title={`${profile.name} — Academic Profile`} description={`Academic profile, research, and selected publications of ${profile.name}.`}>
  <section class="intro page-first">
    <p class="section-kicker">About</p><h2>{profile.headline}</h2>
    {profile.bio.map((paragraph, index) => <p class:list={{ 'intro-lead': index === 0, 'intro-method': index === 1, 'intro-extension': index === 2 }}>{paragraph}</p>)}
    <div class="availability-list" aria-label="Current availability">
      {profile.availability.map((item) => <div class="status-note"><span class="status-dot"></span>{item}</div>)}
    </div>
  </section>
  <section class="home-preview">
    <div class="section-heading"><div><p class="section-kicker">Research</p><h2>Interests & approach</h2></div><a class="text-link" href="/research/">Explore research <ArrowRight size={16} /></a></div>
    <div class="interest-grid compact">
      {researchInterests.map((item, index) => <article class="interest-item"><span>0{index + 1}</span><h3>{item.title}</h3></article>)}
      <article class="interest-item approach-preview"><span>Approach</span><h3>{researchApproach.title}</h3></article>
    </div>
  </section>
  <section class="home-preview">
    <div class="section-heading"><div><p class="section-kicker">Selected work</p><h2>Recent publications</h2></div><a class="text-link" href="/publications/">All publications <ArrowRight size={16} /></a></div>
    <div class="publication-list">{selectedPublications.map((item) => <article class="publication"><div class="publication-year">{item.year}</div><div><h3>{item.url ? <a href={item.url}>{item.title}</a> : item.title}</h3><p class="authors">{item.authors}</p><p class="venue">{item.venue}</p></div></article>)}</div>
  </section>
  <section class="home-preview">
    <div class="section-heading"><div><p class="section-kicker">News & updates</p><h2>Recent activity</h2></div><a class="text-link" href="/updates/">View all updates <ArrowRight size={16} /></a></div>
    <div class="updates-list">{recentUpdates.map((item) => <article class="update-item"><time datetime={item.date}>{formatDate(item.date)}</time><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div>
  </section>
  <footer><span>© {new Date().getFullYear()} {profile.name}</span><span>Built with Astro</span></footer>
</Layout>
