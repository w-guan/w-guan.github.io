---
import Layout from '../layouts/Layout.astro';
import { ArrowUpRight } from '@lucide/astro';
import { conferencePresentations, profile, publications } from '../data/profile';
---
<Layout title={`Publications & Presentations — ${profile.name}`} description={`Publications and conference presentations by ${profile.name}.`}>
  <header class="page-hero page-hero-wide"><p class="section-kicker">Scholarly work</p><h2>Publications & Presentations</h2><p>Peer-reviewed publications, book reviews, and selected conference presentations.</p></header>
  <section class="detail-section publication-page">
    <h2 class="section-title">Publications</h2>
    <div class="publication-list">{publications.map((item) => <article class="publication"><div class="publication-year">{item.year}</div><div><p class="publication-type">{item.type}</p><h3>{item.url ? <a href={item.url}>{item.title} <ArrowUpRight size={15} /></a> : item.title}</h3><p class="authors">{item.authors}</p><p class="venue">{item.venue}</p>{item.note && <p class="publication-note">{item.note}</p>}</div></article>)}</div>
  </section>
  {conferencePresentations.length > 0 && <section class="detail-section presentation-page">
    <h2 class="section-title">Conference presentations</h2>
    <div class="publication-list">{conferencePresentations.map((item) => <article class="publication"><div class="publication-year">{item.date}</div><div><p class="publication-type">{item.type}</p><h3>{item.url ? <a href={item.url} target="_blank" rel="noopener noreferrer">{item.title} <ArrowUpRight size={15} /></a> : item.title}</h3><p class="authors">{item.authors}</p><p class="venue">{item.event} · {item.location}</p>{item.note && <p class="publication-note">{item.note}</p>}</div></article>)}</div>
  </section>}
  <footer><span>© {new Date().getFullYear()} {profile.name}</span><span>Publications & Presentations</span></footer>
</Layout>
