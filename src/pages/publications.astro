---
import Layout from '../layouts/Layout.astro';
import { ArrowUpRight } from '@lucide/astro';
import { profile, publications } from '../data/profile';
---
<Layout title={`Publications — ${profile.name}`} description={`Publications and scholarly work by ${profile.name}.`}>
  <header class="page-hero"><p class="section-kicker">Publications</p><h2>Selected scholarly work.</h2><p>Keep the full record here, while the homepage highlights only your most relevant or recent contributions.</p></header>
  <section class="detail-section publication-page">
    <div class="publication-list">{publications.map((item) => <article class="publication"><div class="publication-year">{item.year}</div><div><p class="publication-type">{item.type}</p><h3>{item.url ? <a href={item.url}>{item.title} <ArrowUpRight size={15} /></a> : item.title}</h3><p class="authors">{item.authors}</p><p class="venue">{item.venue}</p>{item.note && <p class="publication-note">{item.note}</p>}</div></article>)}</div>
  </section>
  <footer><span>© {new Date().getFullYear()} {profile.name}</span><span>Publications</span></footer>
</Layout>
