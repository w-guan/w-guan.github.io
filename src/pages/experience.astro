---
import Layout from '../layouts/Layout.astro';
import { profile, experience } from '../data/profile';
---
<Layout title={`Experience — ${profile.name}`} description={`Academic experience and education of ${profile.name}.`}>
  <header class="page-hero"><p class="section-kicker">Experience</p><h2>Academic positions and education.</h2><p>Present the path that is relevant to your research profile without reproducing every line of your CV.</p></header>
  <section class="detail-section"><div class="experience-list">{experience.map((item) => <article class="experience-item"><div><p class="period">{item.period}</p><span class="item-kind">{item.kind}</span></div><div><h3>{item.role}</h3><p class="institution">{item.institution}</p>{item.description && <p>{item.description}</p>}</div></article>)}</div></section>
  <footer><span>© {new Date().getFullYear()} {profile.name}</span><span>Experience</span></footer>
</Layout>
