---
import Layout from '../layouts/Layout.astro';
import { profile, researchApproach, researchInterests } from '../data/profile';
---
<Layout title={`Research — ${profile.name}`} description={`Research interests and agenda of ${profile.name}.`}>
  <header class="page-hero"><p class="section-kicker">Research</p><h2>Interpreting Language Use in Context</h2><p>My doctoral research uses corpus-based quantitative and qualitative analysis to examine how metadiscourse varies across written and spoken learner texts. Building on this work, I am interested in how context-sensitive interpretations become corpus annotations and form the basis of subsequent quantitative and qualitative analysis. This has led to a broader interest in how methodological choices shape the conclusions drawn from annotated corpus data.</p></header>
  <section class="detail-section">
    <div class="research-list">{researchInterests.map((item, index) => <article class="research-item"><span>0{index + 1}</span><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div>
  </section>
  <section class="detail-section">
    <p class="section-kicker">Approach</p>
    <h2 class="section-title">{researchApproach.title}</h2>
    {researchApproach.paragraphs.map((paragraph) => <p class="wide-copy">{paragraph}</p>)}
  </section>
  <footer><span>© {new Date().getFullYear()} {profile.name}</span><span>Research</span></footer>
</Layout>
