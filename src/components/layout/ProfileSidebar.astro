---
import { Image } from 'astro:assets';
import { BookOpen, Github, Linkedin, Mail, MapPin, X } from '@lucide/astro';
import profileImg from '../../assets/profile.png';
import { profile } from '../../data/profile';

const obfuscatedEmail = `${profile.email.user} [at] ${profile.email.domain.replaceAll('.', ' [dot] ')}`;

---

<aside class="profile-sidebar" id="profile-sidebar">
  <button class="sidebar-close" id="menu-close" aria-label="Close navigation"><X size={22} /></button>
  <a href="/" class="portrait-wrap" aria-label="Home">
    <Image src={profileImg} alt={`Portrait of ${profile.name}`} class="portrait" style={`object-position: ${profile.photoPosition}; transform: translateX(${profile.photoOffsetX}) scale(${profile.photoScale});`} width={360} height={450} loading="eager" fetchpriority="high" />
  </a>
  <div class="identity">
    <h1>{profile.name}</h1>
    <p class="position">{profile.position}</p>
    <p class="affiliation">{profile.affiliation.map((line) => <span>{line}</span>)}</p>
  </div>
  <div class="location"><MapPin size={15} /> {profile.location}</div>
  <p class="sidebar-label">Contact & profiles</p>
  <div class="profile-links" aria-label="Academic links">
    <a class="email-profile" href="/contact/" title={obfuscatedEmail}><Mail size={17} /> Email</a>
    {profile.links.linkedin && <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer"><Linkedin size={17} /> LinkedIn</a>}
    {profile.links.orcid && <a href={profile.links.orcid} target="_blank" rel="noopener noreferrer"><BookOpen size={17} /> ORCID</a>}
    {profile.links.github && <a href={profile.links.github} target="_blank" rel="noopener noreferrer"><Github size={17} /> GitHub</a>}
  </div>
</aside>
